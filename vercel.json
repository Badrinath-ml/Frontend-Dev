{
  "version": 2,
  "buildCommand": "cd Project/foodex-angular && npm install --no-audit --no-fund && npm run build && rm -rf ../angular-dist && cp -r dist/foodex-angular/browser ../angular-dist",
  "outputDirectory": "Project",
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/angular", "destination": "/angular-dist/index.html" },
    { "source": "/angular/(.*\\.(?:js|css|map|ico|svg|png|jpg|jpeg|webp|woff2))", "destination": "/angular-dist/$1" },
    { "source": "/angular/(.*)", "destination": "/angular-dist/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}